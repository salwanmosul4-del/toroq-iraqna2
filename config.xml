<?xml version='1.0' encoding='utf-8'?>
<widget id="com.turuq.iraqna" version="1.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>طرق عراقنا</name>
    <description>تطبيق الطرق العراقي</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#FFFBF8F1" />
    <preference name="android-minSdkVersion" value="24" />
</widget>
